// Runefoble Zanzibar Authorization Schema (SpiceDB)
// Models object-level permissions across campaigns, sessions, characters, and boards.

definition user {}

definition campaign {
    relation owner: user
    relation dungeon_master: user
    relation game_master: user
    relation player: user
    relation spectator: user

    // Owner has supreme management permissions
    permission manage = owner

    // DMs, GMs, and Owner can run sessions, mutate world, assign penalties
    permission run_session = owner + dungeon_master + game_master

    // Active players can interact with their campaign assets
    permission play = run_session + player

    // Spectators can observe the live game
    permission view = play + spectator
}

definition character {
    relation campaign: campaign
    relation owner: user

    // Character can be edited by owner, or by DM (for assigning penalties/effects)
    permission edit = owner + campaign->run_session
    permission view = edit + campaign->view
}

definition game_session {
    relation campaign: campaign

    permission control = campaign->run_session
    permission participate = campaign->play
    permission observe = campaign->view
}

definition session {
    relation campaign: campaign

    permission control = campaign->run_session
    permission participate = campaign->play
    permission observe = campaign->view + participate + control
}

definition board_token {
    relation campaign: campaign
    relation character: character

    // Moving a token requires owning the character or being DM
    permission move = character->edit + campaign->run_session
    permission inspect = campaign->view
}

definition lore_document {
    relation campaign: campaign

    // Public lore visible to campaign viewers; secret lore restricted to DMs/GMs
    permission read_public = campaign->view
    permission read_secret = campaign->run_session
    permission manage = campaign->run_session
}

definition homebrew_rule {
    relation campaign: campaign
    relation author: user

    // Public SRD rules have no campaign restriction; homebrew rules restricted to campaign members or author
    permission view = campaign->view + author
    permission manage = author + campaign->manage + campaign->run_session
    permission edit = manage
}

definition forged_asset {
    relation campaign: campaign
    relation creator: user

    // Assets can be viewed by campaign viewers or the creator
    permission view = campaign->view + creator
    // Editing/managing forged assets requires creator, DM, or campaign owner
    permission manage = creator + campaign->manage + campaign->run_session
    permission edit = manage
}

definition audience_poll {
    relation campaign: campaign
    relation creator: user

    // Viewing and voting is open to campaign viewers (spectators, players, DMs)
    permission view = campaign->view
    permission vote = campaign->view

    // Approving, vetoing, and managing audience chaos proposals requires DM/GM/Owner
    permission moderate = campaign->run_session
    permission approve = campaign->run_session
    permission veto = campaign->run_session
}

definition stronghold {
    relation campaign: campaign
    relation manager: user

    // Campsite/stronghold can be viewed by campaign members
    permission view = campaign->view
    // Upgrading facilities can be performed by active players or designated managers
    permission upgrade = campaign->play + manager
    // Stronghold administration and resets require DM/GM/Owner
    permission manage = campaign->run_session + manager
}

definition diegetic_handout {
    relation campaign: campaign
    relation creator: user

    // Handouts can be viewed by campaign members or creator
    permission view = campaign->view + creator
    // Breaking seal or manipulating handout can be performed by active players or DM
    permission interact = campaign->play + creator
    permission manage = campaign->run_session + creator
}

definition relic {
    relation campaign: campaign
    relation creator: user

    // Relics can be viewed/inspected by campaign members or creator
    permission inspect = campaign->view + creator
    permission manage = campaign->run_session + creator
}

definition faction {
    relation campaign: campaign

    permission view = campaign->view
    permission manage = campaign->run_session
}

definition atlas {
    relation campaign: campaign

    permission view = campaign->view
    permission edit = campaign->run_session
    permission place_pin = campaign->play + campaign->run_session
}

definition codex_entry {
    relation campaign: campaign
    relation author: user
    relation editor: user
    relation reader: user

    // Private codex entries are accessible only to author and direct readers/editors
    permission view = author + editor + reader
    permission edit = author + editor + campaign->run_session
    permission manage = author + campaign->run_session
}

definition shared_world {
    relation guild_officer: user
    relation participant: user
    relation campaign: campaign

    // Guild officers have management authority over the frontier and trade routes
    permission manage = guild_officer

    // Viewing discoveries, outposts, and caravan logs
    permission view = guild_officer + participant + campaign->view

    // Exploring and registering new geographical discoveries
    permission discover = guild_officer + participant + campaign->play

    // Dispatching caravans and trading regional resources
    permission trade = guild_officer + participant + campaign->play
}

definition caravan_contract {
    relation shared_world: shared_world
    relation poster: user
    relation contractor: user
    relation guild_officer: user

    // Viewing contracts available on the notice board
    permission view = poster + contractor + guild_officer + shared_world->view

    // Claiming / accepting a contract requires contractor, guild officer, or shared_world trade authority
    permission claim = contractor + guild_officer + shared_world->trade

    // Fulfilling contract transit or claiming rewards
    permission fulfill = contractor + poster + guild_officer

    // Managing or canceling contracts
    permission manage = poster + guild_officer
}

definition board {
    relation campaign: campaign
    relation dungeon_master: user

    // Secret traps and stage triggers management restricted to DM/GM/Owner
    permission manage_traps = dungeon_master + campaign->run_session
    permission view_secret_layer = dungeon_master + campaign->run_session
    permission switch_map = dungeon_master + campaign->run_session
    permission view = dungeon_master + campaign->view
}

definition settlement {
    relation shared_world: shared_world
    relation campaign: campaign
    relation founder: user
    relation discovering_campaign: campaign
    relation guild_officer: user

    // Viewing settlement requires founder, discovering campaign member, campaign member, guild officer, or shared_world viewer
    permission view = founder + guild_officer + discovering_campaign->view + shared_world->view + campaign->view

    // Upgrading facilities in a haven requires founder, discovering campaign player, campaign member, guild officer, or shared_world trade
    permission upgrade = founder + guild_officer + discovering_campaign->play + shared_world->trade + campaign->play

    // Claiming rest boons / utilizing sanctums
    permission use = founder + guild_officer + discovering_campaign->play + shared_world->discover + campaign->play

    // Managing or defending settlement
    permission manage = founder + guild_officer + shared_world->manage + campaign->run_session
}

definition establishment {
    relation settlement: settlement
    relation campaign: campaign
    relation owner: user
    relation manager: user

    // Viewing establishment
    permission view = owner + manager + settlement->view + campaign->view

    // Managing or upgrading establishment
    permission manage = owner + manager + settlement->manage + campaign->run_session
    permission edit = manage
}

definition bounty_contract {
    relation session: session
    relation campaign: campaign
    relation creator: user
    relation claimant: user

    // Viewing open or active bounties
    permission view = creator + claimant + campaign->view + session->observe

    // Claiming an open bounty requires session/campaign play participation
    permission claim = claimant + campaign->play + session->participate

    // Submitting proof and fulfilling contract
    permission fulfill = claimant + creator

    // Managing contract, resolving disputes, and releasing escrow payout
    permission manage = creator + campaign->run_session + session->control
    permission disburse = creator + campaign->run_session + session->control
}

definition mercenary_bounty {
    relation session: session
    relation campaign: campaign
    relation creator: user
    relation claimant: user

    permission view = creator + claimant + campaign->view + session->observe
    permission claim = claimant + campaign->play + session->participate
    permission fulfill = claimant + creator
    permission manage = creator + campaign->run_session + session->control
    permission disburse = creator + campaign->run_session + session->control
}

definition mcp_tool {
    relation campaign: campaign
    relation author: user

    // Viewing tool definition / schema
    permission view = author + campaign->view

    // Managing, registering, or unregistering dynamic tool requires author or campaign run_session
    permission manage = author + campaign->manage + campaign->run_session

    // Executing or invoking dynamic tool requires author, campaign play permission, or DM/GM
    permission execute = author + campaign->play + manage
}

definition npc {
    relation establishment: establishment
    relation campaign: campaign
    relation manager: user

    // Viewing worker details
    permission view = manager + establishment->view + campaign->view

    // Managing worker role, inventory, and mood
    permission manage = manager + establishment->manage + campaign->run_session
    permission edit_mood = manage + campaign->play
}

definition negotiation {
    relation establishment: establishment
    relation session: session
    relation campaign: campaign
    relation participant: user
    relation arbitrator: user

    // Participant or player can submit gambits and offers
    permission participate = participant + campaign->play + session->participate

    // Viewing negotiation state and barks
    permission view = participate + arbitrator + campaign->view + session->observe + establishment->view

    // Real-time DM arbitration: mood nudging, custom barks, price override, acceptance, ejection
    permission arbitrate = arbitrator + campaign->run_session + session->control + establishment->manage
    permission manage = arbitrate
}




