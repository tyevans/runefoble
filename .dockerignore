# Build context for deployments/docker/python-service.Dockerfile.
# Keep the context small: no VCS data, local virtualenvs, frontend code, docs or tests.

.git
.worktrees
.audit
.venv
**/.venv
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
.mutmut-cache
.coverage
htmlcov

node_modules
**/node_modules
frontend
e2e
docs
tests
tools
scripts
**/ui
**/dist
**/*.log

# Pre-fetched speech models (make voice-model-cache). They reach the pod through a volume, not the image.
.cache
