# Runefoble Inference Worker Configuration Example
# Copy to .env.worker or export as environment variables (prefixed with RUNEFOBLE_WORKER_)

# Server settings
RUNEFOBLE_WORKER_HOST=0.0.0.0
RUNEFOBLE_WORKER_PORT=8100
RUNEFOBLE_WORKER_LOG_LEVEL=INFO

# Backend selection: auto | openai_compatible | ollama | mock
RUNEFOBLE_WORKER_BACKEND=auto

# OpenAI-Compatible Backend (e.g. llama-swap / vLLM / llama.cpp server)
# Default on local GPU machine: http://127.0.0.1:8080/v1
RUNEFOBLE_WORKER_OPENAI_BASE_URL=http://127.0.0.1:8080/v1
RUNEFOBLE_WORKER_OPENAI_MODEL=qwen3.8-27b-txt
RUNEFOBLE_WORKER_OPENAI_API_KEY=none

# Ollama Backend
# Default on local GPU machine: http://127.0.0.1:11434
RUNEFOBLE_WORKER_OLLAMA_BASE_URL=http://127.0.0.1:11434
RUNEFOBLE_WORKER_OLLAMA_MODEL=qwen3.5:9b

# Generation parameters
RUNEFOBLE_WORKER_TEMPERATURE=0.7
RUNEFOBLE_WORKER_MAX_TOKENS=512
RUNEFOBLE_WORKER_TIMEOUT_SECONDS=30.0

# Redis Streams (for async event-driven inference)
RUNEFOBLE_WORKER_REDIS_ENABLED=false
RUNEFOBLE_WORKER_REDIS_URL=redis://127.0.0.1:6379/0
RUNEFOBLE_WORKER_REDIS_STREAM_IN=runefoble.inference.requests
RUNEFOBLE_WORKER_REDIS_STREAM_OUT=runefoble.inference.results
RUNEFOBLE_WORKER_REDIS_CONSUMER_GROUP=runefoble-inference-workers
RUNEFOBLE_WORKER_REDIS_CONSUMER_NAME=worker-01
